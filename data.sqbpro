  ('Dmytro',  'Savchenko', 'dmytro.savchenko@example.com');</sql><sql name="SQL 3">INSERT INTO purchases (player_id, game_id, quantity, purchase_date) VALUES
  (1, 1, 1, DATE('2025-08-15')),
  (1, 2, 2, DATE('2025-08-16')),
