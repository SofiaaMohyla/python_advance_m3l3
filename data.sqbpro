<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/buf1/python_advance_m3l3/data.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="125"/><column_width id="3" width="2459"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,5:maingames"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="games" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="84"/><column index="2" value="168"/><column index="3" value="84"/><column index="4" value="52"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE games (
    game_id     INTEGER PRIMARY KEY AUTOINCREMENT,
    title       TEXT NOT NULL,
    genre       TEXT NOT NULL,
    price       REAL NOT NULL
);

CREATE TABLE players (
    player_id   INTEGER PRIMARY KEY AUTOINCREMENT,
    first_name  TEXT NOT NULL,
    last_name   TEXT NOT NULL,
    email       TEXT NOT NULL UNIQUE
);

CREATE TABLE purchases (
    purchase_id   INTEGER PRIMARY KEY AUTOINCREMENT,
    player_id     INTEGER NOT NULL,
    game_id       INTEGER NOT NULL,
    quantity      INTEGER NOT NULL,
    purchase_date DATE NOT NULL,
    FOREIGN KEY (player_id) REFERENCES players(player_id),
    FOREIGN KEY (game_id)   REFERENCES games(game_id)
);і</sql><sql name="SQL 2">INSERT INTO games (title, genre, price) VALUES
  ('Elden Scrolls V',        'RPG',        59.99),
  ('Galaxy Warfare',         'Shooter',    49.99),
  ('Kingdoms &amp; Castles 2',   'Strategy',   39.99),
  ('Pixel Odyssey',          'Indie',      19.99),
  ('Speed Legends',          'Racing',     29.99),
  ('Mythic Quest Online',    'MMO',        14.99),
  ('Shadow Recon',           'Shooter',    44.99),
  ('FarmVille Neo',          'Simulation', 24.99),
  ('Star Traders',           'Strategy',   34.99),
  ('Dreamscape',             'RPG',        54.99);

INSERT INTO players (first_name, last_name, email) VALUES
  ('Artem',   'Koval',     'artem.koval@example.com'),
