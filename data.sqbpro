</sql><sql name="SQL 4">SELECT * FROM games;
SELECT title, price FROM games;
SELECT DISTINCT genre FROM games;
</sql><sql name="SQL 5">SELECT * FROM games WHERE price &gt; 40;
SELECT title, genre FROM games WHERE genre IN ('RPG','Shooter');
SELECT * FROM players WHERE email LIKE '%@example.com';
</sql><sql name="SQL 6">SELECT title, price FROM games ORDER BY price DESC;
SELECT title, price FROM games ORDER BY price DESC LIMIT 3;
</sql><sql name="SQL 7">SELECT COUNT(*) AS games_total FROM games;
SELECT genre, COUNT(*) AS games_in_genre FROM games GROUP BY genre;
SELECT genre, COUNT(*) AS games_in_genre FROM games GROUP BY genre HAVING COUNT(*) &gt; 1;
</sql><sql name="SQL 8">SELECT * FROM purchases;
SELECT purchase_id, player_id, game_id, quantity, purchase_date FROM purchases WHERE purchase_date &gt;= DATE('2025-08-17');
</sql><sql name="SQL 9">SELECT ROUND(SUM(pu.quantity * g.price), 2) AS total_revenue
FROM purchases pu
JOIN games g ON g.game_id = pu.game_id;</sql><sql name="SQL 10">SELECT pu.purchase_id,
       pu.purchase_date,
       pl.first_name || ' ' || pl.last_name AS player_name,
       pu.game_id,
       pu.quantity
FROM purchases pu
JOIN players pl ON pu.player_id = pl.player_id;

SELECT pu.purchase_id,
       pu.purchase_date,
       pu.player_id,
       g.title,
       pu.quantity
FROM purchases pu
JOIN games g ON pu.game_id = g.game_id;</sql><current_tab id="0"/></tab_sql></sqlb_project>
